{
  // The Worker's entry point, and the only file in the project that knows the
  // encoder is WebAssembly. Everything else is shared with the Node server.
  "name": "listen",
  "main": "src/worker.mjs",
  "compatibility_date": "2025-09-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "rules": [
    {
      "type": "CompiledWasm",
      "globs": [
        "**/mp3.wasm"
      ]
    }
  ],
  "observability": {
    "enabled": true
  },

  // The defaults below are the production pair: Google Cloud Translation and
  // Gemini TTS. A deployment that wants the free demo pair sets
  // LISTEN_TRANSLATE_ENGINE=unofficial and LISTEN_SPEECH_ENGINE=live instead.
  "vars": {
    "LISTEN_TRANSLATE_ENGINE": "cloud",
    "LISTEN_SPEECH_ENGINE": "gemini-tts",
    "GEMINI_TTS_MODEL": "gemini-2.5-flash-preview-tts",
    "GEMINI_LIVE_MODEL": "gemini-3.1-flash-live-preview",
    "GEMINI_TTS_VOICE": "Zephyr",
    "LISTEN_MAX_CHARS": "1000",
    "LISTEN_TTS_CHUNK_CHARS": "200",
    "LISTEN_TTS_CONCURRENCY": "4",
    "LISTEN_TTS_MAX_BISECT": "2",
    "LISTEN_TRANSLATE_ATTEMPTS": "3",
    "LISTEN_CACHE_TTL_SECONDS": "1209600",
    "LISTEN_MAX_LIVE_SESSIONS": "16",
    "LISTEN_RATE_ENABLED": "1",
    "LISTEN_MAX_SLOT_WAIT_MS": "60000",
    "LISTEN_MP3_KBPS": "24",
    "LISTEN_MP3_SAMPLE_RATE": "16000",
    "LISTEN_RATE_PER_DAY": "100",
    "LISTEN_RATE_PER_MINUTE": "5",
    "LISTEN_BUDGET_PER_DAY": "5000",
    "LISTEN_TTS_MAX_ATTEMPTS": "5",
    "LISTEN_TTS_TIMEOUT_MS": "120000"
  }

  // Everything a deployment must not share is set as a secret, not here:
  //
  //   wrangler secret put GEMINI_API_KEY
  //   wrangler secret put GOOGLE_TRANSLATE_API_KEY
  //   wrangler secret put LISTEN_API_KEY
  //   wrangler secret put LISTEN_ALLOWED_ORIGINS
  //   wrangler secret put QSTASH_CURRENT_SIGNING_KEY
  //   wrangler secret put QSTASH_NEXT_SIGNING_KEY
  //   wrangler secret put UPSTASH_REDIS_REST_URL
  //   wrangler secret put UPSTASH_REDIS_REST_TOKEN
  //
  // account_id is deliberately not in this file either: it differs per
  // deployment, and `wrangler deploy` picks it up from `wrangler login` or
  // CLOUDFLARE_ACCOUNT_ID in the environment.
}
