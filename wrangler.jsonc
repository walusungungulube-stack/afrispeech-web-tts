{
  "name": "afrispeech-listen",
  "account_id": "ebe9bb8c8ad59c5bfe074bf7a1234755",
  "main": "src/worker.mjs",
  "compatibility_date": "2025-09-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "rules": [
    {
      "type": "CompiledWasm",
      "globs": [
        "**/mp3.wasm"
      ]
    }
  ],
  "observability": {
    "enabled": true
  },
  "vars": {
    "GEMINI_TTS_MODEL": "gemini-3.1-flash-live-preview",
    "GEMINI_TTS_VOICE": "Zephyr",
    "LISTEN_BUDGET_PER_DAY": "0",
    "LISTEN_CACHE_TTL_SECONDS": "1209600",
    "LISTEN_MAX_CHARS": "3000",
    "LISTEN_SUMMARY_MAX_CHARS": "500",
    "LISTEN_MAX_LIVE_SESSIONS": "300",
    "LISTEN_RATE_ENABLED": "1",
    "LISTEN_MAX_SLOT_WAIT_MS": "60000",
    "LISTEN_MP3_KBPS": "24",
    "LISTEN_MP3_SAMPLE_RATE": "16000",
    "LISTEN_RATE_PER_DAY": "100",
    "LISTEN_RATE_PER_MINUTE": "5",
    "LISTEN_TTS_MAX_ATTEMPTS": "5",
    "LISTEN_TTS_TIMEOUT_MS": "120000"
  },
  "comment": "LISTEN_ALLOWED_ORIGINS is deliberately not in vars: it differs per deployment, so set it with `wrangler secret put LISTEN_ALLOWED_ORIGINS`."
}
