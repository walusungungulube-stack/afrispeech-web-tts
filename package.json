{
  "name": "afrispeech-web-tts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Synthesis server for AfriSpeech Listen: article text in, spoken MP3 out.",
  "main": "src/index.mjs",
  "scripts": {
    "test": "node test/auth.mjs && node test/chunk.mjs && node test/languages.mjs && node test/parallel.mjs && node test/retry.mjs && node test/truncate.mjs",
    "test:e2e": "node --env-file-if-exists=.env test/e2e.mjs",
    "build:speech-data": "node scripts/sync-names.mjs",
    "test:semaphore": "node --env-file-if-exists=.env test/semaphore.mjs",
    "start": "wrangler dev --ip 0.0.0.0 --port 8787"
  },
  "dependencies": {
    "@google/genai": "^2.24.0",
    "@mozilla/readability": "^0.6.0",
    "@upstash/qstash": "^2.11.3",
    "@upstash/redis": "^1.39.0",
    "@upstash/workflow": "^1.3.3",
    "linkedom": "^0.18.13",
    "wasm-media-encoders": "^0.7.0"
  },
  "devDependencies": {
    "mpg123-decoder": "^1.1.0"
  }
}
