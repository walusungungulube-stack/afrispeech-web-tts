# Which services do the work. These are the two decisions that matter, and they
# are meant to be read as a pair. Both default to the production pair.
#
#   production   LISTEN_TRANSLATE_ENGINE=cloud  LISTEN_SPEECH_ENGINE=gemini-tts
#                Google Cloud Translation + Gemini TTS. Billed, quota you can
#                see, no long-lived sockets, a far higher ceiling.
#
#   demo         LISTEN_TRANSLATE_ENGINE=unofficial  LISTEN_SPEECH_ENGINE=live
#                The free translate endpoint + Gemini Live. No account needed,
#                so it is the quickest way to see this work, and it is also
#                unmetered in any way you can inspect and closes hard when a
#                key runs out. Measured: 8 concurrent Live sessions were all
#                served, 16 had 11 refused for quota.
#
# They are independent so they can be mixed, but a production service leaning on
# an endpoint anyone can change underneath it is the thing to avoid.
LISTEN_TRANSLATE_ENGINE=cloud
LISTEN_SPEECH_ENGINE=gemini-tts

# Gemini. This key is the only thing here that costs money, and it must be a key
# you created with billing enabled. It is a secret, never committed, and never
# anything in browser code.
GEMINI_API_KEY=

# The Cloud Translation API key. Needed only when LISTEN_TRANSLATE_ENGINE=cloud.
# Enable the Cloud Translation API on a project with billing first. Also a secret.
GOOGLE_TRANSLATE_API_KEY=

# One model per speech engine, because they are different products.
GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview
GEMINI_TTS_VOICE=Zephyr

# How much of the page is read. All of it is translated and spoken, so a larger
# figure is a longer recording and a larger bill rather than a better one.
LISTEN_MAX_CHARS=1000

# Gemini will not hold a turn open long enough for a whole article, so the
# translated text is spoken in pieces of about this size and the audio is joined.
LISTEN_TTS_CHUNK_CHARS=200
# How many pieces of one article may be spoken at once. This is also how many
# sessions one reader holds, so it counts against LISTEN_MAX_LIVE_SESSIONS.
LISTEN_TTS_CONCURRENCY=4
# How many times a failing piece is halved to recover it, and how many times
# translation is asked again when the pivot out of Thai did not take.
LISTEN_TTS_MAX_BISECT=2
LISTEN_TRANSLATE_ATTEMPTS=3
LISTEN_TTS_MAX_ATTEMPTS=5
LISTEN_TTS_TIMEOUT_MS=120000

LISTEN_MP3_KBPS=24
LISTEN_MP3_SAMPLE_RATE=16000

# How many speech sessions may be open across all readers at once, and how long a
# reader waits for one before being told the service is busy. The default of 16
# is near what was measured on one Live key, not a round number: find your own by
# raising this until runs start failing, and do not take someone else's figure.
LISTEN_MAX_LIVE_SESSIONS=16
LISTEN_MAX_SLOT_WAIT_MS=60000

# How long a finished recording is kept for reuse, in seconds. A recording is
# addressed by a digest of the text and every setting that shaped it, so the same
# article is never recorded twice, and a recording made by one pair of engines is
# never served for the other.
LISTEN_CACHE_TTL_SECONDS=1209600

# Shared secret the website sends as x-listen-key. Without it the endpoint is
# closed, so your Gemini quota cannot be spent by anyone who finds the URL.
LISTEN_API_KEY=

# Origins allowed to call the endpoint, comma separated.
LISTEN_ALLOWED_ORIGINS=https://example.com,https://www.example.com

# Upstash Workflow / QStash / Redis

# The public URL QStash calls back on. Nothing in this repository's source reads
# this: the @upstash/workflow SDK does, as its callback base URL. Leave it unset
# and the SDK derives one from the incoming request, which on a container or a
# box is a private address, and QStash refuses to deliver. DEPLOY.md has the
# full error text.
UPSTASH_WORKFLOW_URL=https://listen.example.org

# The region your QStash account is in. The SDK looks for credentials suffixed
# with this region, so it decides which client is used. A us-east-1 account
# uses US_EAST_1_QSTASH_URL and US_EAST_1_QSTASH_TOKEN below instead.
QSTASH_REGION=eu-central-1
EU_CENTRAL_1_QSTASH_URL=
EU_CENTRAL_1_QSTASH_TOKEN=

QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# What a caller may cost.
LISTEN_RATE_PER_MINUTE=5
LISTEN_RATE_PER_DAY=100
LISTEN_BUDGET_PER_DAY=5000
