# Gemini. This key is the only thing here that costs money, and it must be a key
# you created with billing enabled. It is a secret, never committed, and never
# anything in browser code.
GEMINI_API_KEY=
GEMINI_TTS_MODEL=gemini-3.1-flash-live-preview
GEMINI_TTS_VOICE=Zephyr

# Limits
#
# How much of the page is sent to the model, and how much of that comes back as
# speech. The second is a budget the model is asked to fit a summary inside; it
# cannot be raised past 500, and only audio comes back, so it is a request
# rather than something trimmed afterwards.
LISTEN_MAX_CHARS=3000
LISTEN_SUMMARY_MAX_CHARS=500
LISTEN_MP3_KBPS=24
LISTEN_MP3_SAMPLE_RATE=16000
LISTEN_TTS_TIMEOUT_MS=120000

# A turn that fails is asked again this many times. It is not split in half: two
# halves would be two summaries and so twice the character budget.
LISTEN_TTS_MAX_ATTEMPTS=5

# How many Live sessions may be open across all readers at once, and how long a
# reader waits for one before being told the service is busy. One turn is one
# session and one reader, so this is the number of readers served at the same
# instant; readers past it queue rather than being refused. It is a queue length
# rather than a measured ceiling: what your key actually sustains is a property
# of the key, so find it by raising this until runs start failing.
LISTEN_MAX_LIVE_SESSIONS=300
LISTEN_MAX_SLOT_WAIT_MS=60000

# How long a finished recording is kept for reuse, in seconds. A recording is
# addressed by a digest of the text and the settings that shaped it, so the same
# article is never recorded twice.
LISTEN_CACHE_TTL_SECONDS=1209600

# Shared secret the website sends as x-listen-key. Without it the endpoint is
# closed, so the Gemini quota cannot be spent by anyone who finds the URL.
LISTEN_API_KEY=

# Origins allowed to call the endpoint, comma separated.
LISTEN_ALLOWED_ORIGINS=https://afrispeech.com,https://www.afrispeech.com

# Upstash Workflow / QStash / Redis

# The public URL QStash calls back on. Nothing in this repository's source reads
# this: the @upstash/workflow SDK does, as its callback base URL. Leave it unset
# and the SDK derives one from the incoming request, which on a container or a
# box is a private address, and QStash refuses to deliver. DEPLOY.md has the
# full error text.
UPSTASH_WORKFLOW_URL=https://listen.example.org

# The region your QStash account is in. The SDK looks for credentials suffixed
# with this region, so it decides which client is used. A us-east-1 account
# uses US_EAST_1_QSTASH_URL and US_EAST_1_QSTASH_TOKEN below instead.
QSTASH_REGION=eu-central-1
EU_CENTRAL_1_QSTASH_URL=
EU_CENTRAL_1_QSTASH_TOKEN=

QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# What a caller may cost.
LISTEN_RATE_PER_MINUTE=5
LISTEN_RATE_PER_DAY=100
LISTEN_BUDGET_PER_DAY=5000
